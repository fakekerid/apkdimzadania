<Window x:Class="StoperDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StoperDesktop"
        mc:Ignorable="d"
        Title="Stoper" Height="580" Width="440" MinHeight="500" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Display -->
            <RowDefinition Height="Auto" /> <!-- Controls -->
            <RowDefinition Height="*" />    <!-- Laps List -->
            <RowDefinition Height="Auto" /> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⏱️" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="Stoper" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <CheckBox x:Name="TopmostCheck" Content="Zawsze na wierzchu" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Checked="TopmostCheck_Checked" Unchecked="TopmostCheck_Unchecked" />
            </StackPanel>
        </Grid>

        <!-- Timer Display Card -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="16" BorderBrush="#334155" BorderThickness="1" Padding="20,16" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="StatusTextBlock" Text="Gotowy do startu" FontSize="12" FontWeight="Medium" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock x:Name="TimerDisplay" Text="00:00:00.00" FontFamily="Consolas, Segoe UI" FontSize="42" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                <TextBlock Text="godz : min : sek . setne" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Controls -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="StartStopBtn" Grid.Column="0" Content="Start" Style="{StaticResource ActionButtonStyle}" Background="#10B981" Margin="0,0,8,0" Click="StartStopBtn_Click" />
            <Button x:Name="LapBtn" Grid.Column="1" Content="Międzyczas" Style="{StaticResource ActionButtonStyle}" Background="#334155" Margin="0,0,8,0" IsEnabled="False" Click="LapBtn_Click" />
            <Button x:Name="ResetBtn" Grid.Column="2" Content="Reset" Style="{StaticResource ActionButtonStyle}" Background="#334155" IsEnabled="False" Click="ResetBtn_Click" />
        </Grid>

        <!-- Laps List -->
        <Border Grid.Row="3" Background="#1E293B" CornerRadius="16" BorderBrush="#334155" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,4,8">
                    <TextBlock Text="Okrążenia / Międzyczasy" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" />
                    <TextBlock x:Name="LapCountText" Text="Brak okrążeń" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LapsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F172A" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,6" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding LapNumber}" FontWeight="SemiBold" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LapSplitFormatted}" FontFamily="Consolas" FontWeight="Bold" Foreground="{Binding ColorBrush}" FontSize="13" />
                                            <TextBlock Text="{Binding Tag}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding ColorBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TotalTimeFormatted}" FontFamily="Consolas" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="4" Margin="0,12,0,0" Text="Skróty: Spacja (Start/Pauza) • L (Międzyczas) • R (Reset)" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" />
    </Grid>
</Window>
